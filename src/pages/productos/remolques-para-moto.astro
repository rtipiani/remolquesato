---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import motos from '../../data/remolques-para-moto.json';

const meta = {
	title: "Remolques Porta Motos | Transporte Personalizado",
	description: "Remolques especiales para transportar motos con seguridad. Diseños personalizados con sistemas de sujeción robustos y confiables.",
	image: "https://remolquesato.com/images/category9.avif",
	url: "/productos/remolques-para-moto",
	type: "product"
};
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}');
---
<Layout meta={meta}>
    <section class="bg-gray-50 pt-16 pb-8 px-4 sm:px-6 md:px-12 min-h-screen">
        <div class="container mx-auto text-center">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 tracking-tight">
                Remolques Porta Motos: Transporte Personalizado
            </h1>
            <p class="text-gray-600 text-base sm:text-lg md:text-xl mb-12 max-w-3xl mx-auto leading-relaxed">
                Encuentra el remolque perfecto diseñado específicamente para cada sector y necesidad.
            </p>
            <div class="flex justify-center mb-12">
				<a href="/#categoria" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-black text-white font-semibold text-sm hover:bg-[#7dc35a] hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
					<i class="fa-solid fa-arrow-left"></i>
					Volver al catálogo
				</a>
			</div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{motos.map((moto) => {
					const imagePath = moto.image.replace('./images', '/src/assets/images').replace('/images', '/src/assets/images');
					const imagePromise = images[imagePath] ? images[imagePath]() : moto.image;
					return (
					<div class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1">
						<div class="w-full h-56 sm:h-64 relative overflow-hidden bg-white">
							<Image src={imagePromise} alt={moto.title} loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
							<div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"></div>
						</div>
						<div class="p-6 md:p-8 flex-grow flex flex-col items-center text-center">
							<h2 class="text-lg md:text-xl font-bold text-gray-900 mb-3">{moto.title}</h2>
							<p class="text-gray-500 text-sm md:text-base leading-relaxed mb-6">
								{moto.description}
							</p>
							<a href={`https://wa.me/+51995374449?text=Hola%20Remolques%20ATO%20%26%20PE%C3%91A%2C%20Estoy%20interesado%20en%20adquirir%20"${encodeURIComponent(moto.title)}"`} target="_blank" rel="noopener noreferrer" class="mt-auto group/btn inline-flex items-center justify-center bg-black text-white text-sm md:text-base font-semibold py-1.5 px-6 rounded-lg hover:bg-[#25D366] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
								<i class="fa-brands fa-whatsapp mr-2 text-lg"></i>
								Consultar ahora
							</a>
						</div>
					</div>
				)})}
            </div>            
        </div>
    </section>
    

	<a href="/#categoria" class="fixed bottom-5 left-5 md:bottom-8 md:left-8 bg-black text-white px-4 py-3 md:px-5 md:py-3.5 rounded-full shadow-[0_4px_15px_rgba(0,0,0,0.2)] flex items-center justify-center gap-2 transition-all duration-300 hover:scale-105 hover:bg-[#7dc35a] z-50 text-sm md:text-base font-semibold border border-gray-800 hover:border-[#7dc35a]">
		<i class="fa-solid fa-arrow-left"></i>
		Volver al catálogo
	</a>
</Layout>
