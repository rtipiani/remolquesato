---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import compresores from '../../data/remolques-porta-grupo-electrogeno-y-compresores.json';

const meta = {
	title: "Remolques Porta Grupos Electrógenos | Fabricación y Comercialización",
	description: "Fabricación y comercialización de remolques especializados para grupos electrógenos y compresores. Transporte seguro de equipos de alto valor con sistemas de amarre robusto.",
	image: "https://remolquesato.com/images/category8.avif",
	url: "/productos/remolques-porta-grupo-electrogeno-y-compresores",
	type: "product"
};
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}');
---
<Layout meta={meta}>
    <section class="bg-gray-50 pt-16 pb-8 px-4 sm:px-6 md:px-12 min-h-screen">
        <div class="container mx-auto text-center">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-gray-900 mb-6 tracking-tight max-w-4xl mx-auto leading-tight md:leading-tight lg:leading-tight">
                Remolques Porta Grupos Electrógenos: Fabricación y Ventas
            </h1>
            <p class="text-gray-600 text-lg sm:text-xl md:text-1xl mb-10 max-w-4xl mx-auto">
                Fabricamos y comercializamos remolques especializados para el transporte seguro de grupos electrógenos, compresores y equipos pesados.
            </p>
            <div class="flex justify-center mb-12">
				<a href="/#categoria" class="inline-flex items-center gap-2 px-6 py-2 rounded-full bg-black text-white font-semibold text-sm hover:bg-[#7dc35a] hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
					<i class="fa-solid fa-arrow-left"></i>
					Volver al catálogo
				</a>
			</div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{compresores.map((compresor) => {
					const imagePath = compresor.image.replace('./images', '/src/assets/images').replace('/images', '/src/assets/images');
					const imagePromise = images[imagePath] ? images[imagePath]() : compresor.image;
					return (
					<div class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1">
						<div class="w-full h-56 sm:h-64 relative overflow-hidden bg-white">
							<Image src={imagePromise} alt={compresor.title} loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
							<div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"></div>
						</div>
						<div class="p-6 md:p-8 flex-grow flex flex-col items-center text-center">
							<h2 class="text-lg md:text-xl font-bold text-gray-900 mb-3">{compresor.title}</h2>
							<p class="text-gray-500 text-sm md:text-base leading-relaxed mb-6">
								{compresor.description}
							</p>
							<a href={`https://wa.me/+51995374449?text=Hola%20Remolques%20ATO%20%26%20PE%C3%91A%2C%20Estoy%20interesado%20en%20adquirir%20"${encodeURIComponent(compresor.title)}"`} target="_blank" rel="noopener noreferrer" class="mt-auto group/btn inline-flex items-center justify-center bg-black text-white text-sm md:text-base font-semibold py-1.5 px-6 rounded-lg hover:bg-[#25D366] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
								<i class="fa-brands fa-whatsapp mr-2 text-lg"></i>
								Consultar ahora
							</a>
						</div>
					</div>
				)})}
            </div>            
        </div>
    </section>
    

	<a href="/#categoria" class="fixed bottom-5 left-5 md:bottom-8 md:left-8 bg-[#7dc35a] text-white px-4 py-2 md:px-5 md:py-2.5 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.3)] flex items-center justify-center gap-2 transition-all duration-300 hover:scale-105 hover:shadow-[0_8px_30px_rgb(0,0,0,0.5)] z-50 text-sm md:text-base font-bold">
		<i class="fa-solid fa-arrow-left"></i>
		Volver al catálogo
	</a>
</Layout>
