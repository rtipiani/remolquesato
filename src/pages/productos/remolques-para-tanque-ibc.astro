---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import paneles from '../../data/remolques-para-tanque-ibc.json';

const meta = {
	title: "Remolques para Tanques IBC | Transporte Seguro de Líquidos",
	description: "Remolques especialmente diseñados para el transporte seguro y eficiente de tanques IBC. Fabricación robusta con sistemas de sujeción confiables.",
	image: "https://remolquesato.com/images/category12.avif",
	url: "/productos/remolques-para-tanque-ibc",
	type: "product"
};
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}');
---
<Layout meta={meta}>
    <section class="bg-gray-50 pt-16 pb-8 px-4 sm:px-6 md:px-12 min-h-screen">
        <div class="container mx-auto text-center">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 tracking-tight">
                Remolques para Tanques IBC: Transporte Seguro de Líquidos
            </h1>
            <p class="text-gray-600 text-lg sm:text-xl md:text-1xl mb-10 max-w-4xl mx-auto">
                Encuentra el remolque perfecto diseñado específicamente para cada sector y necesidad.
            </p>
            <div class="flex justify-center mb-12">
				<a href="/#categoria" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-black text-white font-semibold text-sm hover:bg-[#7dc35a] hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
					<i class="fa-solid fa-arrow-left"></i>
					Volver al catálogo
				</a>
			</div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{paneles.map((panel) => {
					const imagePath = panel.image.replace('./images', '/src/assets/images').replace('/images', '/src/assets/images');
					const imagePromise = images[imagePath] ? images[imagePath]() : panel.image;
					return (
					<div class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1">
						<div class="w-full h-56 sm:h-64 relative overflow-hidden bg-white">
							<Image src={imagePromise} alt={panel.title} loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
							<div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"></div>
						</div>
						<div class="p-6 md:p-8 flex-grow flex flex-col items-center text-center">
							<h2 class="text-lg md:text-xl font-bold text-gray-900 mb-3">{panel.title}</h2>
							<p class="text-gray-500 text-sm md:text-base leading-relaxed mb-6">
								{panel.description}
							</p>
							<a href={`https://wa.me/+51995374449?text=Hola%20Remolques%20ATO%20%26%20PE%C3%91A%2C%20Estoy%20interesado%20en%20adquirir%20"${encodeURIComponent(panel.title)}"`} target="_blank" rel="noopener noreferrer" class="mt-auto group/btn inline-flex items-center justify-center bg-black text-white text-sm md:text-base font-semibold py-2.5 px-6 rounded-lg hover:bg-[#25D366] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
								<i class="fa-brands fa-whatsapp mr-2 text-lg"></i>
								Consultar ahora
							</a>
						</div>
					</div>
				)})}
            </div>            
        </div>
    </section>
    
</Layout>
