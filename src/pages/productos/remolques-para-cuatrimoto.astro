---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import cuatrimotos from '../../data/remolques-para-cuatrimoto.json';

const meta = {
	title: "Remolques para Cuatrimotos | Fabricación y Ventas Especializadas",
	description: "Fabricación y ventas de remolques especializados para cuatrimotos. Transporte seguro con sistemas de amarre robusto y diseño personalizado.",
	image: "https://remolquesato.com/images/category10.avif",
	url: "/productos/remolques-para-cuatrimoto",
	type: "product"
};
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}');
---
<Layout meta={meta}>
    <section class="bg-gray-50 pt-28 pb-16 px-4 sm:px-6 md:px-12 min-h-screen">
        <div class="container mx-auto text-center">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 tracking-tight">
            Remolques para Cuatrimotos: Fabricación y Ventas Especializadas
        </h1>
            <p class="text-gray-600 text-base sm:text-lg md:text-xl mb-12 max-w-3xl mx-auto leading-relaxed">
                Fabricamos y vendemos remolques especializados para el transporte seguro de cuatrimotos y ATVs con sistemas de amarre robusto.
            </p>
            <div class="flex justify-center mb-12">
				<a href="/#categoria" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-700 font-semibold text-sm hover:bg-gray-50 hover:text-gray-900 transition-colors shadow-sm">
					<i class="fa-solid fa-arrow-left"></i>
					Volver al catálogo
				</a>
			</div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{cuatrimotos.map((cuatrimoto) => {
					const imagePath = cuatrimoto.image.replace('./images', '/src/assets/images').replace('/images', '/src/assets/images');
					const imagePromise = images[imagePath] ? images[imagePath]() : cuatrimoto.image;
					return (
					<div class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1">
						<div class="w-full h-56 sm:h-64 relative overflow-hidden bg-white">
							<Image src={imagePromise} alt={cuatrimoto.title} loading="lazy" decoding="async" width="800" height="600" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
							<div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"></div>
						</div>
						<div class="p-6 md:p-8 flex-grow flex flex-col items-center text-center">
							<h2 class="text-lg md:text-xl font-bold text-gray-900 mb-3">{cuatrimoto.title}</h2>
							<p class="text-gray-500 text-sm md:text-base leading-relaxed mb-6">
								{cuatrimoto.description}
							</p>
							<a href={`https://wa.me/+51995374449?text=Hola%20Remolques%20ATO%20%26%20PE%C3%91A%2C%20Estoy%20interesado%20en%20adquirir%20"${encodeURIComponent(cuatrimoto.title)}"`} target="_blank" rel="noopener noreferrer" class="mt-auto group/btn inline-flex items-center justify-center bg-black text-white text-sm md:text-base font-semibold py-2.5 px-6 rounded-lg hover:bg-[#25D366] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
								<i class="fa-brands fa-whatsapp mr-2 text-lg"></i>
								Consultar ahora
							</a>
						</div>
					</div>
				)})}
            </div>            
        </div>
    </section>
   	
</Layout>
