---
import { Image } from 'astro:assets';
import slide1 from '../assets/images/slide1.avif';
import slide2 from '../assets/images/slide2.avif';
import slide3 from '../assets/images/slide3.avif';

const slides = [
    {
        src: slide1,
        alt: 'Remolques para Sector Agrícola - Fabricación y Comercialización',
        title: 'para maquinaria del Sector Agrícola',
        description: 'Fabricamos y comercializamos remolques para tractores, sembradoras y cosechadoras. Especialistas en soluciones agrícolas.',
        whatsappLink: 'https://wa.me/+51995374449?text=Hola%20Remolques%20ATO%20%26%20PE%C3%91A,%20me%20interesan%20los%20remolques%20para%20el%20sector%20agr%C3%ADcola.%20%C2%BFPueden%20darme%20m%C3%A1s%20informaci%C3%B3n%3F'
    },
    {
        src: slide2,
        alt: 'Remolques para Minería - Retroexcavadora, Miniexcavadora, Montacargas',
        title: 'para equipos de Minería y Construcción',
        description: 'Fabricación de remolques para retroexcavadoras, miniexcavadoras, montacargas y maquinaria pesada. Comercialización directa.',
        whatsappLink: 'https://wa.me/+51995374449?text=Hola%20Remolques%20ATO%20%26%20PE%C3%91A,%20me%20interesan%20los%20remolques%20para%20construcci%C3%B3n%20y%20miner%C3%ADa.%20%C2%BFPodr%C3%ADan%20ayudarme%20con%20más%20informaci%C3%B3n%3F'
    },
    {
        src: slide3,
        alt: 'Remolques para Grupos Electrógenos y Telecomunicaciones',
        title: 'para Grupos Electrógenos y Telecomunicaciones',
        description: 'Vendemos y fabricamos remolques especializados para grupos electrógenos, compresores y equipos de telecomunicaciones.',
        whatsappLink: 'https://wa.me/+51995374449?text=Hola%20Remolques%20ATO%20%26%20PE%C3%91A,%20me%20interesan%20los%20remolques%20para%20proyectos%20de%20telecomunicaciones.%20%C2%BFPueden%20proporcionarme%20m%C3%A1s%20detalles%3F'
    }
];
---
<div class="relative w-full h-[75vh] md:h-[80vh] lg:h-[90vh] min-h-[480px] md:min-h-[600px] overflow-hidden">
    <div id="slider" class="flex transition-transform duration-700 ease-out h-full">
        {slides.map((slide, index) => (
            <div class="relative flex-shrink-0 w-full h-full">
                <Image src={slide.src} alt={slide.alt} class="w-full h-full object-cover" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} width={1920} height={1080}/>

                <!-- Gradientes para mejorar legibilidad y aspecto premium -->
                <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20"></div>

                <div class="absolute inset-0 flex flex-col justify-center items-start text-left px-6 sm:px-12 md:px-16 lg:px-24 xl:px-32 text-white">
                    <span class="text-[#7dc35a] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm md:text-base mb-4 drop-shadow-md">
                        Calidad & Resistencia
                    </span>
                    <h2 class="text-3xl sm:text-4xl md:text-4xl lg:text-5xl font-extrabold mb-2 leading-tight drop-shadow-xl">
                        Remolques
                    </h2>
                    <p class="text-xl sm:text-2xl md:text-2xl lg:text-3xl font-light text-white/90 mb-6 drop-shadow-lg max-w-[95%] md:max-w-[70%] leading-tight">
                        {slide.title}
                    </p>
                    <p class="text-sm sm:text-base md:text-lg text-gray-300 mb-8 max-w-[95%] sm:max-w-xl leading-relaxed drop-shadow-md border-l-4 border-[#7dc35a] pl-4">
                        {slide.description}
                    </p>
                    
                    <a href={slide.whatsappLink} target="_blank" rel="noopener noreferrer" class="group relative inline-flex items-center overflow-hidden rounded-full bg-[#7dc35a] px-6 py-3 sm:px-8 sm:py-4 text-black font-bold uppercase tracking-wider shadow-[0_0_20px_rgba(125,195,90,0.3)] hover:shadow-[0_0_30px_rgba(125,195,90,0.6)] hover:scale-105 transition-all duration-300">
                        <span class="absolute inset-0 bg-white/30 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
                        <span class="relative flex items-center gap-2 text-sm sm:text-base">
                            Consultar ahora
                            <i class="fa-brands fa-whatsapp text-xl sm:text-2xl ml-1"></i>
                        </span>
                    </a>
                </div>
            </div>
        ))}
    </div>

    <!-- Botones de navegación (Ocultos en móvil, funcionales en Desktop) -->
    <button id="prevBtn" class="absolute top-1/2 left-4 md:left-8 -translate-y-1/2 hidden sm:flex w-10 h-10 sm:w-14 sm:h-14 md:w-16 md:h-16 items-center justify-center rounded-full bg-black/20 backdrop-blur-md border border-white/20 hover:bg-[#7dc35a] text-white hover:text-black transition-all duration-300 shadow-lg group z-10" aria-label="Anterior">
        <i class="fas fa-chevron-left text-lg md:text-2xl transform group-hover:-translate-x-1 transition-transform"></i>
    </button>

    <button id="nextBtn" class="absolute top-1/2 right-4 md:right-8 -translate-y-1/2 hidden sm:flex w-10 h-10 sm:w-14 sm:h-14 md:w-16 md:h-16 items-center justify-center rounded-full bg-black/20 backdrop-blur-md border border-white/20 hover:bg-[#7dc35a] text-white hover:text-black transition-all duration-300 shadow-lg group z-10" aria-label="Siguiente">
        <i class="fas fa-chevron-right text-lg md:text-2xl transform group-hover:translate-x-1 transition-transform"></i>
    </button>

    <!-- Indicadores tipo pill modernos -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 flex space-x-2 z-10">
        {slides.map((_, i) => (
            <button
                class={`h-2 rounded-full transition-all duration-500 ease-out ${i === 0 ? "w-8 bg-[#7dc35a]" : "w-2 bg-white/50 hover:bg-white/80"}`}
                data-index={i}
                aria-label={`Ir a la diapositiva ${i + 1}`}
            ></button>
        ))}
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slider = document.getElementById("slider");
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");
        const indicators = Array.from(document.querySelectorAll("[data-index]"));

        if (!slider) {
            return;
        }

        const slides = Array.from(slider.children);

        if (slides.length === 0) {
            return;
        }

        let currentSlide = 0;

        const updateSlider = () => {
            if (currentSlide >= slides.length || currentSlide < 0) {
                return;
            }

            slider.style.transform = `translateX(-${currentSlide * 100}%)`;

            indicators.forEach((dot, index) => {
                if (index === currentSlide) {
                    dot.classList.add("w-8", "bg-[#7dc35a]");
                    dot.classList.remove("w-2", "bg-white/50", "hover:bg-white/80");
                } else {
                    dot.classList.add("w-2", "bg-white/50", "hover:bg-white/80");
                    dot.classList.remove("w-8", "bg-[#7dc35a]");
                }
            });
        };

        if (prevBtn) {
            prevBtn.addEventListener("click", () => {
                currentSlide = (currentSlide - 1 + slides.length) % slides.length;
                updateSlider();
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", () => {
                currentSlide = (currentSlide + 1) % slides.length;
                updateSlider();
            });
        }

        indicators.forEach((dot) => {
            dot.addEventListener("click", () => {
                const index = dot.getAttribute("data-index");
                if (index !== null) {
                    currentSlide = parseInt(index);
                    updateSlider();
                }
            });
        });

        // Soporte para gestos táctiles (Swipe) en móviles
        let startX = 0;
        let endX = 0;

        slider.addEventListener('touchstart', (e) => {
            startX = e.changedTouches[0].screenX;
        }, { passive: true });

        slider.addEventListener('touchend', (e) => {
            endX = e.changedTouches[0].screenX;
            handleSwipe();
        }, { passive: true });

        const handleSwipe = () => {
            if (endX < startX - 40) {
                // Swipe a la izquierda (Siguiente)
                currentSlide = (currentSlide + 1) % slides.length;
                updateSlider();
            }
            if (endX > startX + 40) {
                // Swipe a la derecha (Anterior)
                currentSlide = (currentSlide - 1 + slides.length) % slides.length;
                updateSlider();
            }
        };

        setInterval(() => {
            currentSlide = (currentSlide + 1) % slides.length;
            updateSlider();
        }, 6000);

        updateSlider();
    });
</script>