---
import { Image } from 'astro:assets';
import categories from "../data/categories.json";

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}');
---
<section id="categoria" class="bg-gray-50 py-12 px-6 md:px-12 pt-24">
    <div class="container mx-auto text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-4 md:mb-6 tracking-tight">
            El Remolque Ideal para <span class="text-[#7dc35a]">Tu Negocio</span>
        </h2>
        <p class="text-gray-600 text-base sm:text-lg lg:text-xl mb-10 max-w-3xl mx-auto leading-relaxed">
            Explora nuestro catálogo de soluciones de alta resistencia. Diseñamos y fabricamos remolques a medida para el sector agrícola, minero, industrial y de construcción, garantizando durabilidad y el máximo rendimiento para tu inversión.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {categories.map(category => {
                const imagePath = category.image.replace('./images', '/src/assets/images');
                if (!images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob: "src/assets/images/*.{jpeg,jpg,png,gif,webp,avif}"`);
                const imagePromise = images[imagePath]();
                return (
                <div class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1">
                    <div class="w-full h-56 sm:h-64 relative overflow-hidden">
                        <Image 
                            src={imagePromise} 
                            alt={category.title} loading="lazy" decoding="async" width={800} height={600}
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                        />
                        <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"></div>
                    </div>
                    
                    <div class="p-6 md:p-8 flex-grow flex flex-col items-center">
                        <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-3 text-center">
                            <a href={category.link} class="hover:text-[#7dc35a] transition-colors duration-300">
                                {category.title}
                            </a>
                        </h3>
                        <p class="text-gray-500 text-sm md:text-base text-center leading-relaxed flex-grow">
                            {category.description}
                        </p>
                    </div>
                    
                    <div class="px-6 pb-6 md:px-8 md:pb-8 mt-auto">
                        <a href={category.link} class="group/btn flex items-center justify-center w-full bg-black text-white font-semibold py-3 px-4 rounded-xl hover:bg-[#7dc35a] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
                            Ver detalles
                            <i class="fas fa-arrow-right ml-2 text-sm transform group-hover/btn:translate-x-1 transition-transform duration-300"></i>
                        </a>
                    </div>
                </div>
            )})}
        </div>
    </div>
</section>